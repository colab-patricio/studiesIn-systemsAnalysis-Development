# Normalize line endings across Windows, macOS and Linux
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.avif binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary

# Jupyter notebooks are JSON; show them as such in diffs and language stats
*.ipynb linguist-language=Jupyter\ Notebook
